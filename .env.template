# --- API ---
# SQLite for local use; on Coolify use the PostgreSQL connection string.
DATABASE_URL=sqlite:///./stexchange.db
# Enables GET /admin/enquiries (send header X-Admin-Token). Leave empty to disable. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Optional email notification of new enquiries (your Postal SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=

# --- UI ---
# Where the Next.js server reaches the API (internal address on Coolify/compose)
API_URL=http://api:8000
NEXT_PUBLIC_SITE_URL=https://stexchange.baseuse.xyz
